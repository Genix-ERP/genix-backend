# GenixERP Backend Configuration
# Copy this file to .env and update the values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=GenixERP
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
APP_DEBUG=true
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_REQUEST_TIMEOUT=30s

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=genix
DB_PASSWORD=genix_secret
DB_NAME=genixerp
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m
DB_MIGRATIONS_PATH=migrations

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=genixerp
JWT_AUDIENCE=genixerp-api

# ===========================================
# CORS Settings
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,X-Tenant-ID
CORS_EXPOSED_HEADERS=Content-Length,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=50

# ===========================================
# AI Integration
# ===========================================
# Provider: openai, anthropic, local
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_ENDPOINT=
AI_REQUEST_TIMEOUT=60s
AI_RATE_LIMIT_PER_MIN=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ===========================================
# File Storage
# ===========================================
# Provider: local, s3, gcs, azure
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_MAX_FILE_SIZE=104857600

# ===========================================
# Email
# ===========================================
# Provider: smtp, sendgrid, ses
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=noreply@genixerp.io
EMAIL_FROM_NAME=GenixERP
EMAIL_API_KEY=

# ===========================================
# Message Queue
# ===========================================
# Provider: redis, rabbitmq, kafka
QUEUE_PROVIDER=redis
QUEUE_URL=redis://localhost:6379/1
QUEUE_WORKERS=10
